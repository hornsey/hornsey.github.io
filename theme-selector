    <script>
        class ThemeSelector {
            constructor() {
                this.currentTheme = 'modern';
                this.isSimpleView = false;
                this.customColors = {
                    primary: '#667eea',
                    secondary: '#764ba2',
                    background: '#667eea',
                    text: '#333333',
                    border: '#e0e0e0'
                };

                this.themes = {
                    modern: {
