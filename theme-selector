                        features: '清新自然、环保健康',
                        usage: '适合环保组织、健康产品等'
                    },
                    sunset: {
                        name: '夕阳温暖',
                        description: '温暖活泼的友好设计风格',
                        colors: ['#FF6B6B', '#FFE66D', '#FFE5B4', '#FFCCBA'],
                        features: '温暖活泼、友好亲切',
                        usage: '适合社交平台、教育机构等'
                    },
                    ocean: {
                        name: '海洋梦幻',
                        description: '梦幻优雅的艺术设计风格',
                        colors: ['#667eea', '#764ba2', '#a8edea', '#fed6e3'],
                        features: '梦幻浪漫、优雅艺术',
                        usage: '适合婚庆网站、创意作品等'
                    },
                    royal: {
                        name: '皇家尊贵',
                        description: '尊贵奢华的设计风格',
                        colors: ['#FFD700', '#FFA500', '#FFF8DC', '#F0E68C'],
                        features: '尊贵奢华、典雅高贵',
                        usage: '适合高端品牌、奢侈品网站等'
                    },
                    neon: {
                        name: '霓虹炫彩',
                        description: '炫酷动感的现代设计风格',
                        colors: ['#FF0080', '#0080FF', '#0F0F23', '#1A1A2E'],
                        features: '炫酷动感、现代时尚',
                        usage: '适合娱乐网站、创意作品等'
                    },
                    minimal: {
                        name: '极简主义',
                        description: '极简纯净的设计风格',
                        colors: ['#2C2C2C', '#4A4A4A', '#FFFFFF', '#F8F8F8'],
                        features: '极简纯净、高效简洁',
                        usage: '适合个人博客、作品集等'
                    },
                    vintage: {
                        name: '复古怀旧',
                        description: '怀旧温馨的设计风格',
                        colors: ['#8B4513', '#A0522D', '#DEB887', '#D2691E'],
                        features: '复古怀旧、温馨舒适',
                        usage: '适合咖啡馆、书店等复古主题'
                    },
                    cyber: {
                        name: '赛博朋克',
                        description: '未来科技的设计风格',
                        colors: ['#00D4FF', '#FF0080', '#0A0A0A', '#1A0033'],
                        features: '未来科技、炫酷时尚',
                        usage: '适合科技网站、游戏网站等'
                    },
                    forest: {
                        name: '森林秘境',
                        description: '神秘宁静的设计风格',
                        colors: ['#228B22', '#32CD32', '#0F4C0F', '#228B22'],
                        features: '神秘自然、宁静舒适',
                        usage: '适合户外网站、环保组织等'
                    }
                };

                this.init();
            }

            init() {
                this.bindEvents();
                this.loadSavedTheme();
                this.loadCustomColors();
            }

            bindEvents() {
                // 主题卡片点击事件
                document.querySelectorAll('.theme-card').forEach(card => {
                    card.addEventListener('click', (e) => {
                        // 如果点击的是按钮，不触发主题切换
                        if (e.target.closest('.theme-actions')) return;

                        const theme = card.dataset.theme;
                        this.switchTheme(theme);
                    });
                });

                // 控制面板按钮事件
                document.getElementById('viewToggle').addEventListener('click', () => this.toggleView());
                document.getElementById('customTheme').addEventListener('click', () => this.openCustomPanel());
                document.getElementById('exportTheme').addEventListener('click', () => this.exportTheme());
                document.getElementById('randomTheme').addEventListener('click', () => this.randomTheme());
                document.getElementById('resetTheme').addEventListener('click', () => this.resetTheme());

                // 筛选按钮事件
                document.querySelectorAll('.filter-btn').forEach(btn => {
                    btn.addEventListener('click', (e) => {
                        this.filterThemes(e.target.dataset.filter);
                    });
                });

                // 颜色选择器事件
                document.querySelectorAll('.color-picker').forEach(picker => {
                    picker.addEventListener('input', (e) => {
                        this.updateCustomColor(e.target.id, e.target.value);
                    });
                });
            }

            switchTheme(theme) {
                if (this.currentTheme === theme) return;

                // 更新当前主题
                this.currentTheme = theme;

                // 更新主题卡片状态
                document.querySelectorAll('.theme-card').forEach(card => {
                    card.classList.remove('active');
                    const indicator = card.querySelector('.active-indicator');
                    if (indicator) {
                        indicator.remove();
                    }
                });

                const activeCard = document.querySelector(`[data-theme="${theme}"]`);
                if (activeCard) {
                    activeCard.classList.add('active');

                    // 添加活动指示器
                    const indicator = document.createElement('div');
                    indicator.className = 'active-indicator';
                    indicator.textContent = '当前主题';
                    activeCard.appendChild(indicator);
                }

                // 更新页面主题
                document.body.className = `theme-${theme}`;

                // 更新演示区域
                const demoArea = document.getElementById('demoArea');
                demoArea.className = `demo-area demo-${theme}`;

                // 更新CSS变量
                this.updateCSSVariables(theme);

                // 保存主题设置
                this.saveTheme(theme);

                // 显示切换通知
                this.showNotification(`已切换到${this.themes[theme].name}主题`, 'success');
            }

            updateCSSVariables(theme) {
                const themeConfig = this.themes[theme];
                if (!themeConfig) return;

                // Create a style element for theme-specific variables
                const styleId = 'theme-variables-style';
                let styleElement = document.getElementById(styleId);

                if (!styleElement) {
                    styleElement = document.createElement('style');
                    styleElement.id = styleId;
                    document.head.appendChild(styleElement);
                }

                // Update global variables for main page layout
                styleElement.textContent = `
                    :root {
                        --primary-color: ${themeConfig.colors[0]};
                        --secondary-color: ${themeConfig.colors[1]};
                        --background-gradient: linear-gradient(135deg, ${themeConfig.colors[0]} 0%, ${themeConfig.colors[1]} 100%);
                    }

                    /* Isolated theme variables for theme cards */
                    .theme-card {
                        --theme-card-primary: var(--primary-color);
                        --theme-card-secondary: var(--secondary-color);
                        --theme-card-background: var(--card-background);
                        --theme-card-text: var(--text-color);
                        --theme-card-border: var(--border-color);
                        --theme-card-shadow: var(--shadow-color);
                    }
                `;

                // Apply theme to body for main page styling
                document.body.className = `theme-${theme}`;

                // Preserve theme card styles by not affecting them with global variables
                this.preserveThemeCardStyles();
            }

            preserveThemeCardStyles() {
                // Ensure theme cards maintain their original styling
                const themeCards = document.querySelectorAll('.theme-card');

                themeCards.forEach(card => {
                    const themeName = card.dataset.theme;
                    if (!themeName) return;

                    // Apply isolated styles to theme cards
                    card.style.setProperty('--card-background', 'rgba(255, 255, 255, 0.95)');
                    card.style.setProperty('--text-color', '#333');
                    card.style.setProperty('--border-color', '#e0e0e0');
                    card.style.setProperty('--shadow-color', 'rgba(0, 0, 0, 0.1)');

                    // Force theme cards to use their specific theme colors
                    const preview = card.querySelector('.theme-preview');
                    if (preview) {
                        // Each theme card should maintain its own preview colors
                        // These are already defined in the CSS classes (.theme-modern .preview-header, etc.)
                        // and should not be affected by global CSS variable changes
                    }
                });
            }
                this.isSimpleView = !this.isSimpleView;
                const btn = document.getElementById('viewToggle');
                const sections = document.querySelectorAll('.theme-section');

                if (this.isSimpleView) {
                    btn.textContent = '📋 详细视图';
                    sections.forEach(section => {
                        if (section.querySelector('.section-title').textContent !== '🌟 热门主题推荐') {
                            section.style.display = 'none';
                        }
                    });
                } else {
                    btn.textContent = '📋 简洁视图';
                    sections.forEach(section => {
                        section.style.display = 'block';
                    });
                }
            }

            filterThemes(filter) {
                // 更新筛选按钮状态
                document.querySelectorAll('.filter-btn').forEach(btn => {
                    btn.classList.remove('active');
                });
                document.querySelector(`[data-filter="${filter}"]`).classList.add('active');

                // 筛选主题卡片
                document.querySelectorAll('.theme-card').forEach(card => {
                    if (filter === 'all') {
                        card.style.display = 'block';
                    } else {
                        const categories = card.dataset.category ? card.dataset.category.split(' ') : [];
                        if (categories.includes(filter)) {
                            card.style.display = 'block';
                        } else {
                            card.style.display = 'none';
                        }
                    }
                });

                this.showNotification(`已筛选显示${this.getFilterName(filter)}主题`, 'info');
            }

            getFilterName(filter) {
                const names = {
                    all: '全部',
                    popular: '热门',
                    business: '商务',
                    creative: '创意',
                    tech: '科技',
                    nature: '自然'
                };
                return names[filter] || '全部';
            }

            openCustomPanel() {
                document.getElementById('customPanel').classList.add('open');
                document.getElementById('overlay').classList.add('show');
            }

            closeCustomPanel() {
                document.getElementById('customPanel').classList.remove('open');
                document.getElementById('overlay').classList.remove('show');
            }

            updateCustomColor(colorId, value) {
                this.customColors[colorId.replace('Color', '')] = value;
            }

            applyCustomTheme() {
                const root = document.documentElement;
                root.style.setProperty('--primary-color', this.customColors.primary);
                root.style.setProperty('--secondary-color', this.customColors.secondary);
                root.style.setProperty('--background-gradient', `linear-gradient(135deg, ${this.customColors.background} 0%, ${this.customColors.secondary} 100%)`);
                root.style.setProperty('--text-color', this.customColors.text);
                root.style.setProperty('--border-color', this.customColors.border);

                this.saveCustomColors();
                this.closeCustomPanel();
                this.showNotification('自定义主题已应用', 'success');
            }

            resetCustomColors() {
                this.customColors = {
                    primary: '#667eea',
                    secondary: '#764ba2',
                    background: '#667eea',
                    text: '#333333',
                    border: '#e0e0e0'
                };

                document.getElementById('primaryColor').value = this.customColors.primary;
                document.getElementById('secondaryColor').value = this.customColors.secondary;
                document.getElementById('backgroundColor').value = this.customColors.background;
                document.getElementById('textColor').value = this.customColors.text;
                document.getElementById('borderColor').value = this.customColors.border;

                this.showNotification('颜色已重置', 'info');
            }

            exportTheme() {
                const themeData = {
                    name: '自定义主题',
                    description: '用户自定义的主题配置',
                    colors: this.customColors,
                    css: this.generateThemeCSS(),
                    timestamp: new Date().toISOString()
                };

                const exportCode = JSON.stringify(themeData, null, 2);
                document.getElementById('exportCode').textContent = exportCode;
                document.getElementById('exportModal').classList.add('show');
                document.getElementById('overlay').classList.add('show');
            }

            generateThemeCSS() {
                return `:root {
    --primary-color: ${this.customColors.primary};
    --secondary-color: ${this.customColors.secondary};
    --background-gradient: linear-gradient(135deg, ${this.customColors.background} 0%, ${this.customColors.secondary} 100%);
    --text-color: ${this.customColors.text};
    --border-color: ${this.customColors.border};
}`;
            }

            randomTheme() {
                const themeKeys = Object.keys(this.themes);
                const randomKey = themeKeys[Math.floor(Math.random() * themeKeys.length)];
                this.switchTheme(randomKey);
            }

            resetTheme() {
                this.switchTheme('modern');
                this.showNotification('主题已重置为默认', 'info');
            }

            saveTheme(theme) {
                localStorage.setItem('selectedTheme', theme);
                localStorage.setItem('themeTimestamp', Date.now());
            }

            loadSavedTheme() {
                const savedTheme = localStorage.getItem('selectedTheme');
                if (savedTheme && this.themes[savedTheme]) {
                    this.switchTheme(savedTheme);
                }
            }

            saveCustomColors() {
                localStorage.setItem('customColors', JSON.stringify(this.customColors));
            }

            loadCustomColors() {
                const saved = localStorage.getItem('customColors');
                if (saved) {
                    this.customColors = JSON.parse(saved);
                    document.getElementById('primaryColor').value = this.customColors.primary;
                    document.getElementById('secondaryColor').value = this.customColors.secondary;
                    document.getElementById('backgroundColor').value = this.customColors.background;
                    document.getElementById('textColor').value = this.customColors.text;
                    document.getElementById('borderColor').value = this.customColors.border;
                }
            }

            showNotification(message, type = 'info') {
                const notification = document.createElement('div');
                const colors = {
                    success: '#4CAF50',
                    error: '#F44336',
                    warning: '#FF9800',
                    info: '#2196F3'
                };

                notification.style.cssText = `
                    position: fixed;
                    top: 20px;
                    right: 20px;
                    background: ${colors[type] || colors.info};
                    color: white;
                    padding: 15px 20px;
                    border-radius: 10px;
                    box-shadow: 0 5px 15px rgba(0,0,0,0.2);
                    z-index: 10000;
                    max-width: 300px;
                    font-size: 14px;
                    transform: translateX(100%);
                    transition: all 0.3s ease;
                `;
                notification.innerHTML = message;

                document.body.appendChild(notification);

                setTimeout(() => {
                    notification.style.transform = 'translateX(0)';
                }, 10);

                setTimeout(() => {
                    notification.style.transform = 'translateX(100%)';
                    setTimeout(() => {
                        if (notification.parentNode) {
                            notification.parentNode.removeChild(notification);
                        }
                    }, 300);
                }, 3000);
            }
        }

        // 全局函数
        function previewTheme(theme) {
            if (window.themeSelector) {
                window.themeSelector.showNotification(`预览${window.themeSelector.themes[theme].name}主题`, 'info');
            }
        }

        function applyTheme(theme) {
            if (window.themeSelector) {
                window.themeSelector.switchTheme(theme);
            }
        }

        function showNotification(message) {
            if (window.themeSelector) {
                window.themeSelector.showNotification(message, 'info');
            }
        }

        function closeCustomPanel() {
            if (window.themeSelector) {
                window.themeSelector.closeCustomPanel();
            }
        }

        function resetCustomColors() {
            if (window.themeSelector) {
                window.themeSelector.resetCustomColors();
            }
        }

        function applyCustomTheme() {
            if (window.themeSelector) {
                window.themeSelector.applyCustomTheme();
            }
        }

        function closeExportModal() {
            document.getElementById('exportModal').classList.remove('show');
            document.getElementById('overlay').classList.remove('show');
        }

        function copyThemeCode() {
            const code = document.getElementById('exportCode').textContent;
            navigator.clipboard.writeText(code).then(() => {
                if (window.themeSelector) {
                    window.themeSelector.showNotification('代码已复制到剪贴板', 'success');
                }
            });
        }

        function downloadThemeCode() {
            const code = document.getElementById('exportCode').textContent;
            const blob = new Blob([code], { type: 'application/json' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `custom-theme-${Date.now()}.json`;
            a.click();
            URL.revokeObjectURL(url);

            if (window.themeSelector) {
                window.themeSelector.showNotification('主题文件已下载', 'success');
            }
        }

        // 初始化主题选择器
        document.addEventListener('DOMContentLoaded', () => {
            window.themeSelector = new ThemeSelector();
        });
    </script>
</body>
</html>
